Новый CVar sys.gc_sustained_low_latency (клиентский, сохраняемый, по
умолчанию включён). Ставится после стартовой полной сборки и
переключается на лету. Блокирующие полные сборки — главный источник
редких длинных фризов у клиента — заменяются фоновыми ценой чуть
большего потребления памяти. Без concurrent GC ни на что не влияет.

Лаунчер ставит игрокам стоковый Robust.Client, так что это, как и
остальные клиентские правки ветки, работает только при запуске из bin.

(cherry picked from commit 61bc8922803f5c7afaada7df3d0de00c2d2e4332)
---
 Robust.Client/GameController/GameController.cs | 7 +++++++
 Robust.Shared/CVars.cs                         | 8 ++++++++
 2 files changed, 15 insertions(+)

diff --git a/Robust.Client/GameController/GameController.cs b/Robust.Client/GameController/GameController.cs
index 60fabdcac..9e8da2840 100644
--- a/Robust.Client/GameController/GameController.cs
+++ b/Robust.Client/GameController/GameController.cs
@@ -269,6 +269,13 @@ namespace Robust.Client
                 GC.Collect();
             }
 
+            // _Duty: ставим после стартовой сборки, чтобы она отработала полностью. Дальше блокирующие
+            // полные сборки — главный источник редких длинных фризов у клиента — заменяются фоновыми.
+            _configurationManager.OnValueChanged(CVars.SysGCSustainedLowLatency, enabled =>
+                GCSettings.LatencyMode = enabled
+                    ? GCLatencyMode.SustainedLowLatency
+                    : GCLatencyMode.Interactive, invokeImmediately: true);
+
             // Setup main loop
             if (_mainLoop == null)
             {
diff --git a/Robust.Shared/CVars.cs b/Robust.Shared/CVars.cs
index 5267fc7f0..c089dd2d4 100644
--- a/Robust.Shared/CVars.cs
+++ b/Robust.Shared/CVars.cs
@@ -558,6 +558,14 @@ namespace Robust.Shared
         public static readonly CVarDef<bool> SysGCCollectStart =
             CVarDef.Create("sys.gc_collect_start", true);
 
+        /// <summary>
+        /// _Duty: run the client GC in <see cref="System.Runtime.GCLatencyMode.SustainedLowLatency"/> mode,
+        /// so blocking full collections are avoided while playing (background gen2 is still allowed).
+        /// Trades a bit of memory for fewer long frame hitches. Has no effect without concurrent GC.
+        /// </summary>
+        public static readonly CVarDef<bool> SysGCSustainedLowLatency =
+            CVarDef.Create("sys.gc_sustained_low_latency", true, CVar.CLIENTONLY | CVar.ARCHIVE);
+
         /// <summary>
         /// Use precise sleeping methods in the game loop.
         /// </summary>
