Режим сборщика мусора общий на весь процесс. Безголовые клиенты
интеграционных тестов живут в одном процессе с сервером и другими
парами, и переключение режима из каждого из них влияло на всех.
Теперь подписка на sys.gc_sustained_low_latency ставится только
при DisplayMode.Clyde.

(cherry picked from commit c2978d1dff1fb5569527459e839f819864f723f5)
---
 Robust.Client/GameController/GameController.cs | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/Robust.Client/GameController/GameController.cs b/Robust.Client/GameController/GameController.cs
index 9e8da2840..0b5f16b4d 100644
--- a/Robust.Client/GameController/GameController.cs
+++ b/Robust.Client/GameController/GameController.cs
@@ -271,10 +271,15 @@ namespace Robust.Client
 
             // _Duty: ставим после стартовой сборки, чтобы она отработала полностью. Дальше блокирующие
             // полные сборки — главный источник редких длинных фризов у клиента — заменяются фоновыми.
-            _configurationManager.OnValueChanged(CVars.SysGCSustainedLowLatency, enabled =>
-                GCSettings.LatencyMode = enabled
-                    ? GCLatencyMode.SustainedLowLatency
-                    : GCLatencyMode.Interactive, invokeImmediately: true);
+            // Только для оконного клиента: режим GC общий на весь процесс, а безголовые клиенты
+            // (интеграционные тесты) живут в одном процессе с сервером и десятком других пар.
+            if (displayMode == DisplayMode.Clyde)
+            {
+                _configurationManager.OnValueChanged(CVars.SysGCSustainedLowLatency, enabled =>
+                    GCSettings.LatencyMode = enabled
+                        ? GCLatencyMode.SustainedLowLatency
+                        : GCLatencyMode.Interactive, invokeImmediately: true);
+            }
 
             // Setup main loop
             if (_mainLoop == null)
