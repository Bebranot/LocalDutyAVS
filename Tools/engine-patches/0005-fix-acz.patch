---
 Robust.Server/ServerStatus/AczBlobStore.cs    | 58 +++++++++++++++----
 .../ServerStatus/StatusHost.Acz.Sources.cs    | 33 ++++++++---
 2 files changed, 72 insertions(+), 19 deletions(-)

diff --git a/Robust.Server/ServerStatus/AczBlobStore.cs b/Robust.Server/ServerStatus/AczBlobStore.cs
index 993918b0d..faedddcbe 100644
--- a/Robust.Server/ServerStatus/AczBlobStore.cs
+++ b/Robust.Server/ServerStatus/AczBlobStore.cs
@@ -81,13 +81,23 @@ internal sealed class AczFileBlobStore : AczBlobStore
     private const int CopyBufferSize = 128 * 1024;
 
     private readonly SafeFileHandle _handle;
-    private readonly string _path;
     private readonly long _length;
 
-    public AczFileBlobStore(SafeFileHandle handle, string path, long length)
+    /// <summary>
+    /// Guards <see cref="_readers"/> and <see cref="_disposed"/>. The handle must outlive every
+    /// download currently reading through it: <see cref="StatusHost.InvalidateAcz"/> can fire at any
+    /// time (a CVar change is enough), and closing the handle under an in-flight launcher would fail
+    /// that download with an <see cref="ObjectDisposedException"/>. Upstream did not have this
+    /// hazard because the blob was a <c>byte[]</c> that the request kept alive by reference.
+    /// </summary>
+    private readonly object _lock = new();
+
+    private int _readers;
+    private bool _disposed;
+
+    public AczFileBlobStore(SafeFileHandle handle, long length)
     {
         _handle = handle;
-        _path = path;
         _length = length;
     }
 
@@ -99,6 +109,9 @@ internal sealed class AczFileBlobStore : AczBlobStore
         int length,
         CancellationToken cancel = default)
     {
+        if (!TryAcquire())
+            throw new ObjectDisposedException(nameof(AczFileBlobStore), "The ACZ blob was invalidated.");
+
         var buffer = ArrayPool<byte>.Shared.Rent(Math.Min(length, CopyBufferSize));
         try
         {
@@ -122,23 +135,46 @@ internal sealed class AczFileBlobStore : AczBlobStore
         finally
         {
             ArrayPool<byte>.Shared.Return(buffer);
+            Release();
         }
     }
 
-    public override void Dispose()
+    private bool TryAcquire()
     {
-        _handle.Dispose();
-
-        try
+        lock (_lock)
         {
-            File.Delete(_path);
+            if (_disposed)
+                return false;
+
+            _readers += 1;
+            return true;
         }
-        catch (IOException)
+    }
+
+    private void Release()
+    {
+        lock (_lock)
         {
-            // Best-effort cleanup; a stale blob file is harmless, the next run overwrites it.
+            _readers -= 1;
+
+            // Whoever leaves last after a Dispose does the actual close.
+            if (_disposed && _readers == 0)
+                _handle.Dispose();
         }
-        catch (UnauthorizedAccessException)
+    }
+
+    public override void Dispose()
+    {
+        lock (_lock)
         {
+            if (_disposed)
+                return;
+
+            _disposed = true;
+
+            // The file itself is FileOptions.DeleteOnClose, so closing the handle removes it.
+            if (_readers == 0)
+                _handle.Dispose();
         }
     }
 }
diff --git a/Robust.Server/ServerStatus/StatusHost.Acz.Sources.cs b/Robust.Server/ServerStatus/StatusHost.Acz.Sources.cs
index 746d81f21..518cdd5c7 100644
--- a/Robust.Server/ServerStatus/StatusHost.Acz.Sources.cs
+++ b/Robust.Server/ServerStatus/StatusHost.Acz.Sources.cs
@@ -252,11 +252,16 @@ internal sealed partial class StatusHost
             {
                 try
                 {
+                    // DeleteOnClose rather than a manual File.Delete: the blob is multiple gigabytes
+                    // and nothing outside this process ever reads it, so let the OS drop it the
+                    // moment the last handle closes - including when the server is killed hard,
+                    // which used to leave the whole blob sitting in the data dir until the next run.
                     _blobHandle = File.OpenHandle(
                         blobPath,
                         FileMode.Create,
                         FileAccess.ReadWrite,
-                        FileShare.None);
+                        FileShare.None,
+                        FileOptions.DeleteOnClose);
                     _blobPath = blobPath;
                 }
                 catch (Exception e)
@@ -407,10 +412,10 @@ internal sealed partial class StatusHost
 
             if (_blobHandle != null)
             {
-                _blobStore = new AczFileBlobStore(_blobHandle, _blobPath!, _blobPosition);
+                _blobStore = new AczFileBlobStore(_blobHandle, _blobPosition);
                 _sawmill.Info(
-                    "ACZ blob written to disk: {BlobSize} bytes over {FileCount} files ({DedupeHits} deduplicated)",
-                    _blobPosition, _infos.Count, _dedupeHits);
+                    "ACZ blob written to '{BlobPath}': {BlobSize} bytes over {FileCount} files ({DedupeHits} deduplicated)",
+                    _blobPath, _blobPosition, _infos.Count, _dedupeHits);
             }
             else
             {
@@ -426,10 +431,22 @@ internal sealed partial class StatusHost
             // _compressStreamPool is actually a DisposableObjectPool, which is an internal type.
             (_compressStreamPool as IDisposable)?.Dispose();
 
-            // If nobody took the store the whole ACZ attempt failed, so don't leave the file handle
-            // (and the file) behind.
-            if (!_blobStoreTaken)
-                _blobStore?.Dispose();
+            if (_blobStoreTaken)
+                return;
+
+            // Nobody took the store, so the ACZ attempt failed and the file must not outlive this
+            // pass. _blobStore only exists once AcceptFinished ran; when the pipeline found no ACZ
+            // source at all (CalcManifestData's `if (!result) return null`) or threw, it is still
+            // null and the raw handle is the only thing holding the file open. Leaking it mattered:
+            // the file is opened FileShare.None, so the next attempt in the same process could not
+            // reopen it and silently fell back to the multi-gigabyte in-heap blob.
+            if (_blobStore != null)
+            {
+                _blobStore.Dispose();
+                return;
+            }
+
+            _blobHandle?.Dispose();
         }
     }
 
