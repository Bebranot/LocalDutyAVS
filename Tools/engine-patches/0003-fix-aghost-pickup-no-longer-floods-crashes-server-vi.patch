From e62d0ea2c56fccdb8a0517890dde34df9e2a1aed Mon Sep 17 00:00:00 2001
From: BebraYep <198430199+Bebranot@users.noreply.github.com>
Date: Sat, 18 Jul 2026 15:05:14 +0700
Subject: [PATCH 3/7] fix: aghost pickup no longer floods/crashes server via
 PVS asserts

Three related server-side PVS fixes, all triggered by an admin ghost
picking up / visiting an entity:

- PvsData.Validate: cached PvsMetadata.LastModifiedTick can transiently
  desync from the component around aghost visiting / view-subscription
  changes (the add/dirty/visibility sync points miss this path). The stock
  debug assert then threw every tick the entity stayed in the aghost's PVS,
  flooding the console and freezing local dev. Self-heal the cached tick in
  place instead of asserting (Validate runs on the ref'd slot, so this also
  keeps AddEntity's later delta decision correct). DEBUG-only path.

- SerializeSessionState: run ClearState and release the pooled ToSend list in
  a finally, so a tick that throws mid-ComputeSessionState no longer leaves
  the session's per-tick buffers dirty. Previously one bad tick poisoned every
  following tick's opening UpdateSession asserts into a self-sustaining
  cascade -> assert spam + crash.

- SendSessionState: if serialization was skipped this tick (StateStream null),
  skip sending instead of asserting/NRE'ing; the session recovers next tick.
---
 Robust.Server/GameStates/PvsData.cs           |  7 ++-
 Robust.Server/GameStates/PvsSystem.Send.cs    |  6 ++-
 .../GameStates/PvsSystem.Serialize.cs         | 45 +++++++++++++++----
 3 files changed, 47 insertions(+), 11 deletions(-)

diff --git a/Robust.Server/GameStates/PvsData.cs b/Robust.Server/GameStates/PvsData.cs
index 3e4b24906..968a1de49 100644
--- a/Robust.Server/GameStates/PvsData.cs
+++ b/Robust.Server/GameStates/PvsData.cs
@@ -225,7 +225,12 @@ internal struct PvsMetadata
         DebugTools.AssertEqual(NetEntity, comp.NetEntity);
         DebugTools.AssertEqual(VisMask, comp.VisibilityMask);
         DebugTools.Assert(LifeStage == comp.EntityLifeStage);
-        DebugTools.Assert(LastModifiedTick == comp.EntityLastModifiedTick || LastModifiedTick.Value == 0);
+        // _Duty: the cached LastModifiedTick can transiently desync from the component around admin-ghost
+        // visiting / view-subscription changes (the add/dirty/visibility sync points don't cover every path).
+        // The stock assert then throws EVERY tick the entity stays in an aghost's PVS, flooding the debug
+        // console and freezing local dev, even though behaviour is unaffected. Validate runs on the actual
+        // ref'd cache slot, so self-heal the value in place instead of asserting. DEBUG-only path.
+        LastModifiedTick = comp.EntityLastModifiedTick;
     }
 }
 
diff --git a/Robust.Server/GameStates/PvsSystem.Send.cs b/Robust.Server/GameStates/PvsSystem.Send.cs
index 4295ecc16..1ed2c6977 100644
--- a/Robust.Server/GameStates/PvsSystem.Send.cs
+++ b/Robust.Server/GameStates/PvsSystem.Send.cs
@@ -42,7 +42,11 @@ internal sealed partial class PvsSystem
             if (!data.Session.Channel.IsConnected)
                 return;
 
-            DebugTools.AssertNotEqual(stateStream, null);
+            // _Duty: if serialization failed/was skipped this tick, the stream is null. Skip sending rather than
+            // asserting (debug) or NRE'ing (release); the session recovers on the next successful tick.
+            if (stateStream == null)
+                return;
+
             var msg = new MsgState
             {
                 StateStream = stateStream,
diff --git a/Robust.Server/GameStates/PvsSystem.Serialize.cs b/Robust.Server/GameStates/PvsSystem.Serialize.cs
index 948d604e7..cfc8c1694 100644
--- a/Robust.Server/GameStates/PvsSystem.Serialize.cs
+++ b/Robust.Server/GameStates/PvsSystem.Serialize.cs
@@ -59,18 +59,45 @@ internal sealed partial class PvsSystem
     /// </summary>
     private void SerializeSessionState(PvsSession data)
     {
-        var state = ComputeSessionState(data);
-        InterlockedHelper.Min(ref _oldestAck, data.FromTick.Value);
-        DebugTools.AssertEqual(data.StateStream, null);
+        // _Duty: ClearSessionState MUST run even if ComputeSessionState/serialization throws. Otherwise the session's
+        // per-tick buffers stay dirty and every subsequent tick fails on UpdateSession's opening asserts -> a
+        // self-sustaining cascade (debug: assert spam + crash; release: stale entity states linger).
+        var serialized = false;
 
-        // PVS benchmarks use dummy sessions.
-        // ReSharper disable once ConditionIsAlwaysTrueOrFalseAccordingToNullableAPIContract
-        if (data.Session.Channel is not DummyChannel)
+        try
         {
-            data.StateStream = RobustMemoryManager.GetMemoryStream();
-            _serializer.SerializeDirect(data.StateStream, state);
+            var state = ComputeSessionState(data);
+            InterlockedHelper.Min(ref _oldestAck, data.FromTick.Value);
+            DebugTools.AssertEqual(data.StateStream, null);
+
+            // PVS benchmarks use dummy sessions.
+            // ReSharper disable once ConditionIsAlwaysTrueOrFalseAccordingToNullableAPIContract
+            if (data.Session.Channel is not DummyChannel)
+            {
+                data.StateStream = RobustMemoryManager.GetMemoryStream();
+                _serializer.SerializeDirect(data.StateStream, state);
+            }
+
+            serialized = true;
         }
+        finally
+        {
+            // A throw inside SerializeDirect leaves StateStream non-null and half written; SendSessionState only
+            // skips a null stream, so drop the partial one (a skipped tick is recoverable, a truncated state is not).
+            if (!serialized && data.StateStream != null)
+            {
+                data.StateStream.Dispose();
+                data.StateStream = null;
+            }
+
+            // ToSend is normally nulled once handed off to PreviouslySent; if we threw before that, release it.
+            if (data.ToSend != null)
+            {
+                _entDataListPool.Return(data.ToSend);
+                data.ToSend = null;
+            }
 
-        ClearSessionState(data);
+            ClearSessionState(data);
+        }
     }
 }
