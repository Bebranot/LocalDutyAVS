<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'duty-code-alpha-prompt-title'}"
                      MinSize="420 220"
                      SetSize="420 220">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <RichTextLabel Name="BodyLabel" Access="Public" VerticalExpand="True" />
        <Label Name="CountdownLabel" Access="Public" HorizontalAlignment="Center" />
        <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="12">
            <Button Name="ConfirmButton" Access="Public"
                    Text="{Loc 'duty-code-alpha-prompt-confirm'}" StyleClasses="ButtonColorRed" />
            <Button Name="DenyButton" Access="Public"
                    Text="{Loc 'duty-code-alpha-prompt-deny'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
