<controls:DefaultWindow xmlns="https://spacestation14.io"
                        xmlns:controls="clr-namespace:Robust.Client.UserInterface.CustomControls;assembly=Robust.Client"
                        Title="{Loc 'duty-erp-status-window-title'}"
                        MinSize="380 320"
                        Resizable="False">
    <BoxContainer Orientation="Vertical" SeparationOverride="6" Margin="6 6 6 6">
        <Label Name="CurrentStatusLabel" Text="" />
        <Label Name="CooldownLabel" Text="" StyleClasses="LabelSubText" />
        <PanelContainer StyleClasses="LowDivider" Margin="0 4 0 4" />

        <BoxContainer Orientation="Vertical" SeparationOverride="2">
            <Button Name="NoneButton" ToggleMode="True" Text="{Loc 'duty-erp-status-option-none'}" HorizontalExpand="True" />
            <Label Text="{Loc 'duty-erp-status-desc-none'}" StyleClasses="LabelSubText" Margin="4 0 0 8" />

            <Button Name="ModerateButton" ToggleMode="True" Text="{Loc 'duty-erp-status-option-moderate'}" HorizontalExpand="True" />
            <Label Text="{Loc 'duty-erp-status-desc-moderate'}" StyleClasses="LabelSubText" Margin="4 0 0 8" />

            <Button Name="FullButton" ToggleMode="True" Text="{Loc 'duty-erp-status-option-full'}" HorizontalExpand="True" />
            <Label Text="{Loc 'duty-erp-status-desc-full'}" StyleClasses="LabelSubText" Margin="4 0 0 8" />
        </BoxContainer>

        <Control VerticalExpand="True" />

        <Button Name="ApplyButton" Text="{Loc 'duty-erp-status-apply'}" HorizontalExpand="True" />
    </BoxContainer>
</controls:DefaultWindow>
