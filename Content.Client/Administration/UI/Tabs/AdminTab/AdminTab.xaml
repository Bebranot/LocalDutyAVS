<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:at="clr-namespace:Content.Client.Administration.UI.Tabs.AdminTab"
    Margin="4"
    MinSize="50 50">
    <!-- _Duty-start: кнопки разбиты на группы с заголовками; группа без доступных кнопок прячется -->
    <BoxContainer Orientation="Vertical" SeparationOverride="6">
        <Label Name="PlayersHeader" Text="{Loc duty-admin-tab-group-players}" StyleClasses="LabelHeading" />
        <GridContainer Name="PlayersGroup" Columns="3">
            <cc:CommandButton Command="banpanel" Text="{Loc admin-player-actions-window-ban}" />
            <!-- ADT-Tweak-Start -->
            <cc:CommandButton Command="playersdashboard" Text="{Loc admin-player-actions-window-players-dashboard}"/>
            <cc:UICommandButton Command="playtime-panel" Text="{Loc admin-player-actions-window-playtime-panel}" WindowType="{x:Type at:PlayTimeEditorWindow}" />
            <!-- ADT-Tweak-End -->
        </GridContainer>

        <Label Name="ChatHeader" Text="{Loc duty-admin-tab-group-chat}" StyleClasses="LabelHeading" />
        <GridContainer Name="ChatGroup" Columns="3">
            <cc:CommandButton Command="announceui" Text="{Loc admin-player-actions-window-announce}"/>
            <cc:CommandButton Command="achatwindow" Text="{Loc admin-player-actions-window-admin-chat}"/>
            <cc:CommandButton Command="faxui" Text="{Loc admin-player-actions-window-admin-fax}"/>
            <!-- ADT-Tweak-Start -->
            <cc:UICommandButton Command="echo-chat-panel" Text="{Loc admin-player-actions-window-echo-chat-panel}" WindowType="{x:Type at:EchoChatPanelWindow}"/>
            <!-- ADT-Tweak-End -->
        </GridContainer>

        <Label Name="ToolsHeader" Text="{Loc duty-admin-tab-group-tools}" StyleClasses="LabelHeading" />
        <GridContainer Name="ToolsGroup" Columns="3">
            <cc:CommandButton Command="aghost" Text="{Loc admin-player-actions-window-admin-ghost}" />
            <cc:UICommandButton Command="callshuttle" Text="{Loc admin-player-actions-window-shuttle}" WindowType="{x:Type at:AdminShuttleWindow}"/>
            <cc:CommandButton Command="adminlogs" Text="{Loc admin-player-actions-window-admin-logs}"/>
            <cc:CommandButton Command="permissions" Text="{Loc admin-player-actions-window-permissions}" />
        </GridContainer>
    </BoxContainer>
    <!-- _Duty-end -->
</Control>
