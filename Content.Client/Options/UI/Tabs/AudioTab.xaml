<Control xmlns="https://spacestation14.io"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:ui="clr-namespace:Content.Client.Options.UI">
    <BoxContainer Orientation="Vertical">
        <BoxContainer Orientation="Vertical" Margin="8 8 8 8" VerticalExpand="True">
            <Label Text="{Loc 'ui-options-volume-label'}"
                   StyleClasses="LabelKeyText"/>
            <BoxContainer Orientation="Vertical" Margin="0 3 0 0">
                <ui:OptionSlider Name="SliderVolumeMaster" Title="{Loc 'ui-options-master-volume'}"
                                 Margin="0 0 0 8" />
                <!-- ADT Barks start -->
                <ui:OptionSlider Name="SliderVolumeBarks" Title="{Loc 'ui-options-barks-volume'}" />
                <!-- ADT Barks end -->
                <ui:OptionSlider Name="SliderVolumeMidi" Title="{Loc 'ui-options-midi-volume'}" />
                <ui:OptionSlider Name="SliderVolumeAmbientMusic" Title="{Loc 'ui-options-ambient-music-volume'}"
                                 ToolTip="{Loc 'ui-options-ambient-music-volume-tooltip'}" />
                <ui:OptionSlider Name="SliderVolumeAmbience" Title="{Loc 'ui-options-ambience-volume'}"
                                 ToolTip="{Loc 'ui-options-ambience-volume-tooltip'}" />
                <ui:OptionSlider Name="SliderVolumeLobby" Title="{Loc 'ui-options-lobby-volume'}" />
                <ui:OptionSlider Name="SliderVolumeInterface" Title="{Loc 'ui-options-interface-volume'}" />
                <!-- ADT Boss music start -->
                <ui:OptionSlider Name="SliderVolumeBossMusic" Title="{Loc 'ui-options-boss-music-volume'}" />
                <!-- ADT Boss music end -->
                <ui:OptionSlider Name="SliderMaxAmbienceSounds" Title="{Loc 'ui-options-ambience-max-sounds'}"
                                 ToolTip="{Loc 'ui-options-ambience-max-sounds-tooltip'}" />

                <Label Text="{Loc 'ui-options-audio-events-label'}" StyleClasses="LabelKeyText" Margin="0 8 0 0"/>
                <CheckBox Name="LobbyMusicCheckBox" Text="{Loc 'ui-options-lobby-music'}" />
                <CheckBox Name="RestartSoundsCheckBox" Text="{Loc 'ui-options-restart-sounds'}"
                          ToolTip="{Loc 'ui-options-restart-sounds-tooltip'}" />
                <CheckBox Name="EventMusicCheckBox" Text="{Loc 'ui-options-event-music'}" />
                <!-- ADT Boss music start -->
                <CheckBox Name="BossMusicCheckBox" Text="{Loc 'ui-options-boss-music'}" />
                <!-- ADT Boss music end -->
                <CheckBox Name="AdminSoundsCheckBox" Text="{Loc 'ui-options-admin-sounds'}"
                          ToolTip="{Loc 'ui-options-admin-sounds-tooltip'}" />
                <CheckBox Name="BwoinkSoundCheckBox" Text="{Loc 'ui-options-bwoink-sound'}"
                          ToolTip="{Loc 'ui-options-bwoink-sound-tooltip'}" />

                <Label Text="{Loc 'ui-options-chat-highlight-header'}" StyleClasses="LabelKeyText" Margin="0 8 0 0"/>
                <!-- ADT-tweak start -->
                <CheckBox Name="ChatHighlightSoundCheckBox" Text="{Loc 'ui-options-chat-highlight-sound'}"
                          ToolTip="{Loc 'ui-options-chat-highlight-sound-tooltip'}" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <ui:OptionDropDown Name="DropDownChatHighlightSound" Title="{Loc 'ui-options-chat-highlight-sound-choice'}"
                                     Margin="0 0 4 0" />
                    <Button Name="ChatHighlightSoundPlayButton" Text="{Loc 'ui-options-chat-highlight-sound-play'}" />
                </BoxContainer>
                <ui:OptionSlider Name="SliderChatHighlightSoundVolume" Title="{Loc 'ui-options-chat-highlight-sound-volume'}"
                                 Margin="0 0 0 8" />
                <!-- ADT-tweak end -->

                <!-- _Duty -->
                <CheckBox Name="LoginSoundCheckBox" Text="{Loc 'ui-options-login-sound'}"
                          ToolTip="{Loc 'ui-options-login-sound-tooltip'}" />
            </BoxContainer>
        </BoxContainer>
        <ui:OptionsTabControlRow Name="Control" Access="Public" />
    </BoxContainer>
</Control>
