<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               xmlns:duty="clr-namespace:Content.Client._Duty.Construction">
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
        <!-- _Duty: категории вертикальным сайдбаром вместо выпадающего OptionButton. -->
        <duty:CategorySidebar Name="CategoryList" Access="Public" Margin="0 0 5 0"/>
        <!-- _Duty: MaxWidth фиксирует колонку: иначе длинная подсказка поиска раздувала бы её. -->
        <BoxContainer Orientation="Vertical" MinWidth="243" MaxWidth="243" Margin="0 0 5 0">
            <LineEdit Name="SearchBar" PlaceHolder="{Loc 'construction-menu-search'}"
                      HorizontalExpand="True" Margin="0 0 0 5"/>
            <!-- _Duty: подсказка, когда поиск внутри выбранной категории ничего не нашёл. -->
            <BoxContainer Name="SearchHintBox" Orientation="Vertical" Visible="False" Margin="0 0 0 5">
                <RichTextLabel Name="SearchHintLabel"/>
                <Button Name="SearchEverywhereButton" HorizontalExpand="True"/>
            </BoxContainer>
            <controls:ListContainer Name="Recipes" Access="Public" Group="True" Toggle="True" VerticalExpand="True" />
            <ScrollContainer Name="RecipesGridScrollContainer" VerticalExpand="True" Access="Public" Visible="False">
                <GridContainer Name="RecipesGrid" Columns="5" Access="Public"/>
            </ScrollContainer>
        </BoxContainer>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal">
                <Button Name="MenuGridViewButton" ToggleMode="True" Text="{Loc construction-menu-grid-view}"/>
                <Button Name="FavoriteButton" Visible="false"/>
                <Control HorizontalExpand="True"/>
                <!-- _Duty: тумблер боковой панели избранного, прижат вправо — под крестиком окна. -->
                <Button Name="FavoritesPanelToggleButton" Visible="False"/>
            </BoxContainer>
            <!-- _Duty: инфо-блок фиксированной высоты. Название и описание лежат в скролле с
                 выключенным горизонтальным скроллом: он даёт тексту конечную ширину (перенос по
                 колонке) и сам сообщает нулевую желаемую ширину. Из-за этого длина описания
                 больше не может растягивать окно — раньше при переключении между рецептами с
                 разной длиной текста окно дёргалось. -->
            <BoxContainer Orientation="Horizontal" MinHeight="72" Margin="0 0 0 5">
                <EntityPrototypeView Name="TargetTexture" VerticalAlignment="Center" Stretch="Fill" Margin="0 0 10 0"/>
                <ScrollContainer HScrollEnabled="False" HorizontalExpand="True" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                        <RichTextLabel Name="TargetName"/>
                        <RichTextLabel Name="TargetDesc"/>
                    </BoxContainer>
                </ScrollContainer>
            </BoxContainer>
            <ItemList Name="RecipeStepList" Access="Public" VerticalExpand="True" Margin="0 0 0 5"/>
            <BoxContainer Orientation="Vertical">
                <Button Name="BuildButton" Disabled="True" ToggleMode="True"
                        VerticalExpand="True" SizeFlagsStretchRatio="0.5"/>
                <BoxContainer Orientation="Horizontal" VerticalExpand="True" SizeFlagsStretchRatio="0.5">
                    <Button Name="EraseButton" ToggleMode="True"
                        HorizontalExpand="True" SizeFlagsStretchRatio="0.7"/>
                    <Button Name="ClearButton" HorizontalExpand="True" SizeFlagsStretchRatio="0.3"/>
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
        <!-- _Duty: панель избранного. Показывается только при наличии избранного; окно при этом
             расширяется вправо, левый край и остальные колонки не двигаются. -->
        <duty:FavoritesPanel Name="FavoritesSidePanel" Access="Public" Visible="False"/>
    </BoxContainer>
</DefaultWindow>
