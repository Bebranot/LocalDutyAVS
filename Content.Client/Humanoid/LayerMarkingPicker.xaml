<BoxContainer xmlns="https://spacestation14.io" Orientation="Vertical">
    <!-- _Duty: кнопка очистки поиска -->
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
        <LineEdit Name="SearchBar" PlaceHolder="{Loc 'markings-search'}" HorizontalExpand="True" />
        <Button Name="ClearSearchButton" Text="✕" ToolTip="{Loc 'duty-markings-search-clear'}" Visible="False" />
    </BoxContainer>
    <ScrollContainer Name="SelectionItems" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Vertical">
            <!-- _Duty: выбранное — отдельной секцией сверху -->
            <Label Name="SelectedHeader" Text="{Loc 'duty-markings-selected'}" StyleClasses="LabelHeading" Margin="4 4 4 0" Visible="False" />
            <GridContainer Name="SelectedItems" Columns="2" Margin="4" Visible="False" />
            <!-- ADT-Tweak-Start -->
            <Label Name="SponsorHeader" Text="{Loc 'adt-sponsor-marking-category'}" StyleClasses="LabelHeading" Margin="4 4 4 0" Visible="False" />
            <GridContainer Name="SponsorItems" Columns="2" Margin="4" Visible="False" />
            <Label Name="RegularHeader" Text="{Loc 'duty-markings-available'}" StyleClasses="LabelHeading" Margin="4 4 4 0" Visible="False" />
            <!-- ADT-Tweak-End -->
            <GridContainer Name="Items" Columns="2" Margin="4" />
        </BoxContainer>
    </ScrollContainer>
    <ScrollContainer Name="OrderingItems" HorizontalExpand="True" VerticalExpand="True" Visible="False">
    </ScrollContainer>
    <BoxContainer HorizontalExpand="True" Margin="4">
        <Label Name="MarkingsStatus" HorizontalExpand="True" />
        <Button Name="ReorderButton" ToggleMode="True" Text="{Loc 'markings-reorder'}" />
    </BoxContainer>
</BoxContainer>
