# Крафт самодельного Т-90М: станок, броне-сталь, детали, узлы сборки. Имена готовой техники и боеприпасов — в entities.ftl.

# Категории
construction-category-duty-tank = Самодельный танк
lathe-category-duty-tank-materials = Материалы
lathe-category-duty-tank-engine = Двигатель
lathe-category-duty-tank-chassis = Ходовая и защита
lathe-category-duty-tank-armament = Вооружение
lathe-category-duty-tank-ammo = Боеприпасы

# Материал и стак
materials-duty-armor-steel = броне-сталь
stack-duty-armor-steel =
    { $amount ->
        [1] лист
        [few] листа
       *[other] листов
    } броне-стали

stack-duty-t90-roadwheel =
    { $amount ->
        [1] каток
        [few] катка
       *[other] катков
    }

stack-duty-t90-trackkit =
    { $amount ->
        [1] комплект
        [few] комплекта
       *[other] комплектов
    }

stack-duty-t90-reliktblock =
    { $amount ->
        [1] блок
        [few] блока
       *[other] блоков
    }

# Шаги сборки
duty-tank-step-motor = модульная машинная часть
duty-tank-step-cylinder-block = блок цилиндров В-92
duty-tank-step-turbocharger = турбокомпрессор
duty-tank-step-fuel-pump = ТНВД
duty-tank-step-gearbox = коробка передач
duty-tank-step-engine = двигатель В-92 в сборе
duty-tank-step-barrel = заготовка ствола 125 мм
duty-tank-step-breech = казённик
duty-tank-step-autoloader = карусель АЗ
duty-tank-step-kalina = блок СУО «Калина»
duty-tank-step-pktm = пулемёт ПКТМ
duty-tank-step-kord = пулемёт «Корд»
duty-tank-step-dumv = модуль ДУМВ
duty-tank-step-shell-apfsds = снаряд 3БМ60 (БОПС)
duty-tank-step-shell-hefrag = снаряд 3ОФ26 (ОФС)
duty-tank-step-shell-heat = снаряд 3БК29М (КС)
duty-tank-step-charge = метательный заряд

# Сущности
ent-DutyTankWorkshop = танковый станок
    .desc = Лейт, сваренный из лома и самоуверенности. Переплавляет металл в детали танка, а как — лучше не спрашивать. Нужны питание и золотые руки.

ent-SheetDutyArmorSteel = броне-сталь
    .suffix = Полный
    .desc = Грубый броне-стальной лист, откованный из того, что нашлось. Тяжёлый и упрямый.
ent-SheetDutyArmorSteel10 = броне-сталь
    .suffix = 10
    .desc = { ent-SheetDutyArmorSteel.desc }
ent-SheetDutyArmorSteel1 = броне-сталь
    .suffix = Один
    .desc = { ent-SheetDutyArmorSteel.desc }

ent-DutyT90CylinderBlock = блок цилиндров В-92
    .desc = Двенадцатицилиндровый дизельный блок, отлитый из металлолома и упрямства. Тяжёлый: лучше катить, чем нести.

ent-DutyT90Turbocharger = турбокомпрессор
    .desc = Турбина наддува, собранная из всего, что крутилось. Свистит, как чайник.

ent-DutyT90FuelPump = ТНВД
    .desc = Топливный насос высокого давления. Подтекает, но качает.

ent-DutyT90Gearbox = коробка передач
    .desc = Планетарная коробка передач танка. Шестерни подогнаны кувалдой.

ent-DutyT90RoadWheel = каток
    .desc = Опорный каток с резиновым бандажом из переплавленного пластика.

ent-DutyT90TrackKit = комплект траков
    .desc = Звенья гусеничной ленты на пальцах. Лязгают громче, чем выглядят.

ent-DutyT90BarrelBlank = заготовка ствола 125 мм
    .desc = Откованная труба под гладкоствольную пушку. Выглядит грозно, хотя канал ещё не доведён.

ent-DutyT90Breech = казённик
    .desc = Казённая часть пушки с клиновым затвором. Весит как небольшая машина.

ent-DutyT90Autoloader = карусель АЗ
    .desc = Карусель автомата заряжания на два десятка выстрелов. Крутится, когда не заедает.

ent-DutyT90Kalina = блок СУО «Калина»
    .desc = Баллистический вычислитель и прицельный комплекс. Внутри золото, стекло и надежда на лучшее.

ent-DutyT90PKTM = пулемёт ПКТМ
    .desc = Танковый 7,62-мм пулемёт, спаренный с пушкой. Без ленты просто железка.

ent-DutyT90Kord = пулемёт «Корд»
    .desc = Крупнокалиберный 12,7-мм пулемёт. Тяжёлый, мощный, любит патроны.

ent-DutyT90DUMV = ДУМВ
    .desc = Дистанционно управляемый модуль вооружения под «Корд». Поворачивается, куда скажут.

ent-DutyT90ReliktBlock = блок ДЗ «Реликт»
    .desc = Контейнер динамической защиты со взрывчатым слоем. Молотком не бить.

ent-DutyT90ShellAPFSDS = снаряд 3БМ60 (БОПС)
    .desc = Подкалиберный оперённый снаряд с длинным сердечником. Раздельное заряжание: нужен метательный заряд.

ent-DutyT90ShellHEFrag = снаряд 3ОФ26 (ОФС)
    .desc = Осколочно-фугасный снаряд. Раздельное заряжание: нужен метательный заряд.

ent-DutyT90ShellHEAT = снаряд 3БК29М (КС)
    .desc = Кумулятивный снаряд. Раздельное заряжание: нужен метательный заряд.

ent-DutyT90PropellantCharge = метательный заряд
    .desc = Горючая гильза с порохом для раздельного заряжания. Курить рядом не рекомендуется.

ent-DutyT90MEngine = двигатель В-92 в сборе
    .desc = Танковый дизель с турбонаддувом, ТНВД и коробкой передач, собранный на стенде. Живой, тяжёлый и громкий. Тянуть, а не нести.

ent-DutyTankWorkshopFrame = рама танкового станка
    .desc = Стальная рама будущего станка: сварена, но без начинки.

ent-DutyT90EngineStand = стенд сборки двигателя
    .desc = Сварной стенд для сборки танкового дизеля. На него садятся блок, турбина, ТНВД и коробка.

ent-DutyT90HullFrame = рама корпуса танка
    .desc = Силовой набор корпуса из стали и броне-стали, сваренный прямо на полу.

ent-DutyT90HullBottom = корпус танка: днище
    .desc = Днище корпуса уже закрыто бронелистами. Сверху ещё много работы.

ent-DutyT90HullSides = корпус танка: борта
    .desc = Днище и борта корпуса заварены. Танк пока без носа и крыши.

ent-DutyT90HullGlacis = корпус танка: ВЛД
    .desc = Верхний лобовой лист на месте. Осталась крыша.

ent-DutyT90HullRoof = корпус танка: крыша
    .desc = Корпус закрыт сверху, моторный отсек пуст. Нужен двигатель и проводка.

ent-DutyT90TurretBox = башня-коробка
    .desc = Погон и коробка башни из броне-стали. Орудия ещё нет.

ent-DutyT90TurretGun = башня с пушкой
    .desc = Башня со стволом и казёнником. Зарядить пока нечем.

ent-DutyT90TurretSights = башня с АЗ и прицелом
    .desc = Пушка, карусель АЗ и «Калина» на месте. Осталось привесить пулемёт.

ent-DutyT90TracksBogies = балки подвески
    .desc = Сварные балки под катки. Колёс ещё нет.

ent-DutyT90TracksLeft = ходовая: один борт
    .desc = Катки и траки на одном борту. Второй борт ждёт своей очереди.

ent-DutyT90ReliktRack = каркас под ДЗ
    .desc = Сварной каркас под блоки динамической защиты.

ent-DutyT90KordMount = станина под «Корд»
    .desc = Сварная станина под дистанционный модуль.
