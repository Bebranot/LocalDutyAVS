# Имена и описания техники и боеприпасов Т-90М (прототипы Resources/Prototypes/_Duty/Tank/{RMC,Vehicle}).

# --- Танк и его узлы ---
ent-DutyVehicleT90M = самодельный Т-90М «Прорыв»
    .desc = Основной боевой танк, собранный из металлолома и упрямства. Едет, стреляет, иногда даже в нужную сторону.
    .suffix = Самодельный

ent-DutyHardpointT90Turret = башня Т-90М
    .desc = Литая башня с гладкоствольной пушкой 2А46М-5 и спаренным ПКТМ. Заряжание раздельное, автомат заряжания на 22 выстрела.

ent-DutyHardpointT90Tracks = ходовая Т-90М
    .desc = Гусеницы, катки и торсионы. Тяжёлые настолько, что поднимать лучше вдвоём.

ent-DutyHardpointT90Relikt = ДЗ «Реликт» Т-90М
    .desc = Блоки динамической защиты на корпус и башню. Срабатывают с громким хлопком и гасят кумулятив.

ent-DutyHardpointT90Kord = Корд с ДУМВ Т-90М
    .desc = Дистанционный крупнокалиберный модуль 12,7 мм на крыше башни. Управляется командиром изнутри.

ent-DutyHardpointT90CannonAPFSDS = пушка 2А46М-5 (БОПС)
    .desc = Стодвадцатипятка, заряженная бронебойным подкалиберным. Для всего, что нужно пробить насквозь.

ent-DutyHardpointT90CannonHEFrag = пушка 2А46М-5 (ОФС)
    .desc = Та же пушка, заряженная осколочно-фугасным. Для пехоты, стен и плохого настроения.

ent-DutyHardpointT90CannonHEAT = пушка 2А46М-5 (КС)
    .desc = Та же пушка, заряженная кумулятивным. Прожигает броню, но взрыв небольшой.

ent-DutyHardpointT90PKT = спаренный ПКТМ
    .desc = Танковый пулемёт 7,62 мм, спаренный с пушкой. Лента на 250 патронов.

ent-DutyT90AutoLoader = автомат заряжания Т-90М
    .desc = Карусельный автомат заряжания на 22 выстрела. Снаряды и ленточные короба подносят вручную.

# --- Боеприпасы ---
ent-DutyCartridge125APFSDS = выстрел 125 мм БОПС
    .desc = Выстрел в сборе: бронебойный подкалиберный снаряд 3БМ60 с метательным зарядом.

ent-DutyCartridge125HEFrag = выстрел 125 мм ОФС
    .desc = Выстрел в сборе: осколочно-фугасный снаряд 3ОФ26 с метательным зарядом.

ent-DutyCartridge125HEAT = выстрел 125 мм КС
    .desc = Выстрел в сборе: кумулятивный снаряд 3БК29М с метательным зарядом.

ent-DutyMagazineBelt762Tank = короб ленты 7,62×54R (250)
    .desc = Короб с лентой для ПКТМ.

ent-DutyMagazineBelt127Tank = короб ленты 12,7×108 (150)
    .desc = Короб с лентой для «Корда».

ent-DutyBullet125APFSDS = подкалиберный сердечник 125 мм
ent-DutyBullet125HEFrag = осколочно-фугасный снаряд 125 мм
ent-DutyBullet125HEAT = кумулятивный снаряд 125 мм
ent-DutyBulletTank127 = пуля (12,7×108)
ent-DutyTankRound125APFSDS = выстрел 125 мм БОПС
ent-DutyTankRound125HEFrag = выстрел 125 мм ОФС
ent-DutyTankRound125HEAT = выстрел 125 мм КС
ent-DutyTankRound127 = патрон (12,7×108)

# --- Общая техника RMC ---
ent-ActionVehicleToggleView = Сменить вид
    .desc = Переключает обзор между салоном и видом снаружи.

ent-ActionVehicleSelectHardpoint = Выбрать оружие
    .desc = Выбрать это оружие для стрельбы.

ent-RMCVehicleKey = ключ от техники
    .desc = Ключ, выточенный под конкретный замок.

ent-VehicleTurretVisual = башня техники

ent-VehicleExitArea = выход из техники
    .desc = Метка выхода из машины. Нажмите, чтобы выбраться наружу.

ent-VehicleViewport = смотровая щель
    .desc = Узкая щель, через которую можно глянуть наружу.

ent-VehicleViewportUnanchored = смотровая щель
    .desc = Узкая щель, через которую можно глянуть наружу.

ent-VehicleInvisibleWallNoVision = невидимая стена (без блокировки обзора)
    .desc = Невидимая преграда в интерьере техники, не закрывающая обзор и свет.

ent-RMCWallInvisibleBulletBlocker = ограничитель стены
    .desc = Невидимая стена, останавливающая пули и проход.
    .suffix = Блок пуль

ent-RMCWallInvisibleBulletLightBlocker = ограничитель стены
    .desc = Невидимая стена, останавливающая пули, проход и свет.
    .suffix = Блок пуль и света

ent-RMCVehicleWreckExplosion = взрыв остова техники
    .desc = Взрыв уничтоженной машины. Пол не ломает.
    .suffix = Взрывается по сигналу

ent-VehicleInteriorExtinguisherClosed = огнетушитель салона
    .desc = Настенный шкафчик с огнетушителем.
    .suffix = Закрыт

ent-RMCSeatTankDriver = место механика-водителя
    .desc = Бронированное кресло с рычагами управления танком.

ent-RMCSeatTankGunner = место наводчика
    .desc = Бронированное кресло с прицелом и спусками орудий.

ent-RMCSeatTankCommander = место командира
    .desc = Бронированное кресло командира с панелью дистанционного модуля.

ent-VehicleSPPTankChassis = днище танка
    .desc = Силовой набор днища внутри танка.

ent-VehicleSPPTankSmallLocker = ящик танка
    .desc = Небольшой железный ящик для вещей экипажа.

ent-VehicleSPPTankAmmoLoader = автомат заряжания
    .desc = Автомат заряжания для оружия техники.
