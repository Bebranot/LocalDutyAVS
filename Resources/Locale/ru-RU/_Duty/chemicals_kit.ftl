# _Duty: набор химикатов для аплинка ядерных оперативников.
# Сущности: Resources/Prototypes/_Duty/Entities/Objects/chemicals_kit.yml
# Лот аплинка: Resources/Prototypes/_Duty/Catalog/uplink_catalog.yml
# дипсик привет
duty-uplink-chemicals-kit-name = набор химикатов
duty-uplink-chemicals-kit-desc =
    Вещмешок с пятью подписанными кувшинами растворов на все основные случаи полевой медицины и гипоручкой для инъекций.
    [color=red]Продаётся только один раз за операцию[/color] — используй с умом.

duty-chemicals-kit-name = вещмешок с набором химикатов
duty-chemicals-kit-desc =
    Полевая аптека ядерных оперативников: пять кувшинов по 200 ед. готовых растворов и гипоручка,
    чтобы набирать дозы прямо в бою. [color=yellow]Экономьте — второго такого мешка не будет[/color].

duty-jug-dexalin-saline-name = Дексалиново-физрастворный раствор
duty-jug-dexalin-saline-desc =
    [color=cyan]100 ед. физраствора[/color] + [color=cyan]100 ед. дексалина[/color].
    Восполняет кровопотерю и снимает лёгкое кислородное голодание — то, что нужно бойцу
    на ногах ещё до того, как он поймёт, что ранен. Колоть сразу после огневого контакта,
    не дожидаясь потери сознания.
    [color=yellow]Рекомендовано ~6 инъекций[/color] по 5 ед. (2.5 физраствора + 2.5 дексалина за укол).

duty-jug-burn-relief-name = Противоожоговый раствор
duty-jug-burn-relief-desc =
    [color=orange]100 ед. дермалина[/color] + [color=orange]100 ед. сульфадиазина серебра[/color].
    Пара для термических и химических ожогов: дермалин лечит повреждение тканей изнутри,
    сульфадиазин — снимает воспаление и защищает открытые раны от заражения снаружи.
    Первым делом — на обожжённые конечности после взрывов и энергооружия.
    [color=yellow]Рекомендовано ~6 инъекций[/color] по 5 ед. (2.5 дермалина + 2.5 сульфадиазина за укол).

duty-jug-anti-hemorrhage-name = Противотравматический раствор
duty-jug-anti-hemorrhage-desc =
    [color=#c0392b]100 ед. бикаридина[/color] + [color=#c0392b]100 ед. кровоостанавливающей пудры[/color].
    Бикаридин стабилизирует тяжёлые механические травмы, пудра тут же останавливает кровотечение —
    вместе они держат бойца в строю, пока хирург занят кем-то другим.
    [color=yellow]Рекомендовано ~6 инъекций за раз[/color] (2.5 бикаридина + 2.5 пудры за укол).

duty-jug-antitoxin-name = Концентрированный антитоксин
duty-jug-antitoxin-desc =
    [color=lightgreen]200 ед. диловена[/color]. Антитоксин широкого спектра на случай газовых ловушек,
    отравленных клинков и прочих сюрпризов станции. Держите под рукой на случай, если операция
    пойдёт не по плану.
    [color=yellow]Рекомендовано ~40 инъекций[/color] по 5 ед. чистого диловена за укол.

duty-jug-critical-care-name = Раствор для легкораненных
duty-jug-critical-care-desc =
    [color=violet]200 ед. трикордразина[/color]. Ровным слоем подлечивает сразу все виды урона —
    но заметно это только когда боец не сильно ранен: [color=red]эффективен при малых ранениях[/color], колоть для профилактики.
    [color=yellow]Рекомендации отсутствуют. Передоза нет.
