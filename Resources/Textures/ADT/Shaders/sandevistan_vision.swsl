// _Duty: Edgerunners Sandevistan vision shader (chromatic aberration, neon cyan/emerald-magenta grading, pulse vignette).
uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

void fragment() {
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp vec2 dir = uv - vec2(0.5);
    highp float dist = length(dir);

    // Subtle pulse that scales with active strength.
    highp float pulse = 0.90 + 0.10 * sin(TIME * 5.2);
    highp float s = clamp(strength, 0.0, 1.0);

    // Radial chromatic aberration (stronger toward screen edges).
    highp vec2 caOffset = dir * (0.0035 + 0.0095 * dist) * s;
    highp vec4 baseCol = zTextureSpec(SCREEN_TEXTURE, uv);
    highp float r = zTextureSpec(SCREEN_TEXTURE, clamp(uv + caOffset, vec2(0.001), vec2(0.999))).r;
    highp float g = baseCol.g;
    highp float b = zTextureSpec(SCREEN_TEXTURE, clamp(uv - caOffset, vec2(0.001), vec2(0.999))).b;
    highp vec3 caCol = vec3(r, g, b);

    // Edgerunners neon color grading: cool emerald/cyan in shadows-midtones, subtle magenta/amber in highlights.
    highp float luma = dot(caCol, vec3(0.299, 0.587, 0.114));
    highp vec3 shadowTint = vec3(0.05, 0.92, 0.80);
    highp vec3 highlightTint = vec3(1.00, 0.35, 0.72);
    highp vec3 targetGrade = mix(shadowTint, highlightTint, smoothstep(0.35, 0.92, luma));
    highp vec3 graded = mix(caCol, caCol * targetGrade * 1.15 + targetGrade * 0.08 * (1.0 - luma), 0.45 * s);

    // Speed vignette with subtle neon rim.
    highp float vig = smoothstep(0.30, 0.76, dist) * s * pulse;
    highp vec3 rimColor = mix(vec3(0.0, 0.95, 0.75), vec3(1.0, 0.15, 0.65), 0.5 + 0.5 * sin(TIME * 2.5 + dir.x * 3.0));
    graded = mix(graded, graded * 0.78 + rimColor * 0.16, vig * 0.65);

    highp vec3 finalRgb = mix(baseCol.rgb, graded, s);
    COLOR = vec4(finalRgb, baseCol.a);
}
