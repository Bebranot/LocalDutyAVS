// _Duty: subtle desaturated cold time-dilation tint for slowed bystanders during Sandevistan.
uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

void fragment() {
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;
    highp vec4 baseCol = zTextureSpec(SCREEN_TEXTURE, uv);
    highp float s = clamp(strength, 0.0, 1.0);

    // Partial desaturation + cold slate-cyan shift.
    highp float luma = dot(baseCol.rgb, vec3(0.299, 0.587, 0.114));
    highp vec3 desat = mix(baseCol.rgb, vec3(luma), 0.48 * s);
    highp vec3 cold = desat * mix(vec3(1.0), vec3(0.78, 0.90, 1.08), s);

    // Very subtle cold corner vignette for temporal dilation feel.
    highp float dist = length(uv - vec2(0.5));
    highp float vig = smoothstep(0.38, 0.86, dist) * 0.22 * s;
    cold = mix(cold, vec3(0.06, 0.14, 0.22), vig);

    COLOR = vec4(cold, baseCol.a);
}
