// _Duty: экранный эффект стимулятора Fury-16.
// Радиальная сине-голубая виньетка («бублик»: прозрачный центр, свечение к краям/углам)
// + лёгкое волнистое искажение + резкая пульсация под бит (раз в ~0.417 c).
// Всё масштабируется юниформой strength (0 = выкл, 1 = пик).

uniform sampler2D SCREEN_TEXTURE;
uniform highp float strength;

void fragment() {
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE.xy;

    // Резкая пульсация «под бит»: спайк с очень быстрым спадом (на 20% быстрее прежнего).
    // beat 0..1 за период ~0.417 c; pulse — резкий фронт в начале такта.
    highp float beat = fract(TIME * 2.4);
    highp float pulse = pow(1.0 - beat, 6.0);
    highp float s = strength * (0.55 + 0.45 * pulse);

    // Волнистое искажение восприятия.
    highp float amp = s * 0.004;
    highp vec2 offset = vec2(
        sin(uv.y * 12.0 + TIME * 2.0) * amp,
        cos(uv.x * 12.0 + TIME * 1.5) * amp);
    highp vec4 col = zTextureSpec(SCREEN_TEXTURE, uv + offset);

    // Радиальная виньетка: расстояние от центра (0 в центре, ~0.707 в углах).
    // smoothstep формирует «бублик» — тёмная дыра в центре, голубое кольцо к углам.
    highp float dist = length(uv - vec2(0.5));
    highp float vig = smoothstep(0.30, 0.72, dist);
    vig *= s;

    highp vec3 tint = vec3(0.15, 0.55, 1.0);
    col.rgb = mix(col.rgb, tint, vig * 0.75);
    col.rgb *= 1.0 - vig * 0.25;   // лёгкое затемнение краёв усиливает объём «бублика»

    COLOR = col;
}
